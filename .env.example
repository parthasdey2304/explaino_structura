# ── Explaino Structura — environment template ──────────────────────────
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`
# (or any `.env*` / `*.local` file) — it is gitignored. The same keys must
# be set in Vercel: Project Settings → Environment Variables.
#
# RULE: server secrets below are intentionally NOT prefixed with
# NEXT_PUBLIC_ or VITE_. Next.js only inlines prefixed vars into the browser
# bundle; unprefixed vars exist solely in Route Handlers (/api/...), which is
# the only path the client may use to reach Mistral, Judge0 and E2B.

# ── Mistral (AI chat + AI Text; server route /api/ai/chat) ────────────────
# Get one at https://console.mistral.ai/api-keys
# Optional when every user supplies bring-your-own-key in the AI panel.
MISTRAL_API_KEY=

# ── Gemini (voice assistant; currently bring-your-own-key in the UI) ──────
# Get one at https://aistudio.google.com/apikey
# Reserved for future server-side use; the live voice session today uses the
# key the user pastes into the app (localStorage only, never committed).
GEMINI_API_KEY=

# ── Judge0 (Java/Dart execution; server route /api/execute) ───────────────
# Base URL of the Judge0 instance. Defaults to the free public CE cloud when
# empty; point it at a self-hosted/VPS instance to run privately.
JUDGE0_BASE_URL=https://ce.judge0.com
# Optional API key. Only sent when JUDGE0_API_HOST is set, as the RapidAPI
# `X-RapidAPI-Key` header. The CE cloud and self-hosted instances need none.
JUDGE0_API_KEY=
# Only for RapidAPI-hosted Judge0, e.g. judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=

# ── E2B (sandboxed terminal sessions; server routes /api/terminal/*) ──────
# Get one at https://e2b.dev — server-side only, never exposed to the browser.
E2B_API_KEY=

# ── Firebase web config (server + client) ──────────────────────────────────
# Firebase API keys are public identifiers by design (enforced by Firebase
# security rules, not by secrecy), so NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
