# ── Explaino Structura — environment template ──────────────────────────
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`
# (or any `.env*` / `*.local` file) — it is gitignored. The same keys must
# be set in Vercel: Project Settings → Environment Variables.
#
# RULE: server secrets below are intentionally NOT prefixed with
# NEXT_PUBLIC_ or VITE_. Next.js only inlines prefixed vars into the browser
# bundle; unprefixed vars exist solely in Route Handlers (/api/...), which is
# the only path the client may use to reach Gemini.

# Teacher login: set private values locally and in Vercel (never NEXT_PUBLIC_).
EXPLAINO_ADMIN_PASSWORD=
EXPLAINO_SESSION_SECRET=
# Optional; defaults to the existing teacher email.
EXPLAINO_ADMIN_EMAIL=

# Shared canvas storage on Vercel: connect a Turso database on the free Starter
# plan. Its Marketplace integration provides these two server-only variables.
# Local development uses data/explaino.db when they are unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Gemini (AI chat, text-to-diagram, canvas text, voice; server routes /api/ai/*) ──
# Get one at https://aistudio.google.com/apikey
# Powers Gemini 3.8 Flash & Gemini 3.5 Flash
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# ── Mistral (AI chat, text-to-diagram, canvas text; server routes /api/ai/*) ──
# Get one at https://console.mistral.ai/api-keys
# Powers Codestral, Mistral Small & Open Mistral Nemo
MISTRAL_API_KEY=
NEXT_PUBLIC_MISTRAL_API_KEY=

# ── Firebase web config (server + client) ──────────────────────────────────
# Firebase API keys are public identifiers by design (enforced by Firebase
# security rules, not by secrecy), so NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
